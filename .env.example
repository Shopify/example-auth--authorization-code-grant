# Copy this file to .env and fill in your app's credentials, then run from the
# repo root so both samples pick it up:
#   node node/index.js       (after `npm install` in node/)
#   python python/main.py    (after `pip install -r python/requirements.txt`)

# Your app's credentials from the Dev Dashboard
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The callback URL configured in the Dev Dashboard
# (for example, https://your-app.example.com/callback)
REDIRECT_URI=

# Comma-separated list of access scopes to request
SCOPES=read_products,write_orders

# Node.js: secret used to sign session cookies. Generate a long random value:
#   openssl rand -hex 64
COOKIE_SECRET=

# Python: secret used to sign the session cookie. Generate a long random value:
#   openssl rand -hex 64
SESSION_SECRET=

# Set to "production" when serving over HTTPS so the session cookie gets the
# Secure flag. Leave as "development" for local HTTP dev.
# Node.js reads NODE_ENV; Python reads APP_ENV.
NODE_ENV=development
APP_ENV=development
